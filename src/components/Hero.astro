---
import type { ProEvent } from "../lib/types";

interface Props {
  initialProEvents: ProEvent[];
}

const { initialProEvents } = Astro.props;
import HeroCarousel from "./HeroCarousel.svelte";
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-dark">
  <div class="absolute inset-0 z-0 pointer-events-none select-none">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/content/rave_poster.jpg"
      class="w-full h-full object-cover opacity-60"
    >
      <source src="/content/rave_video.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-linear-to-b from-dark/20 via-dark/60 to-dark"></div>
  </div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <HeroCarousel initialProEvents={initialProEvents} client:load />
  </div>

  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-30">
    <a
      href="#bilety"
      aria-label="Przewiń do biletów"
      class="flex flex-col items-center gap-2 text-muted hover:text-primary transition-colors duration-300 group"
    >
      <span class="text-sm font-sans uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        WYDARZENIA
      </span>
      <svg
        class="w-8 h-8 animate-bounce"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>
