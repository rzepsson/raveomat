---
import ContactForm from "./ContactForm.svelte";
---

<section id="kontakt" class="py-32 px-6 lg:px-8 bg-dark relative z-20">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24">
      
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-3 mb-8">
            <span class="w-8 h-0.5 bg-primary"></span>
            <span class="text-xs font-bold uppercase tracking-[0.3em] text-primary">
              Współpraca
            </span>
          </div>
          
          <h2 class="text-5xl md:text-6xl font-display font-extrabold tracking-tighter text-foreground uppercase leading-[0.9] mb-8">
            Kontakt
          </h2>
          
          <p class="text-lg text-muted font-light mb-16 leading-relaxed max-w-md">
            Budujesz nową markę? Potrzebujesz niezawodnego systemu biletowego? Jesteśmy gotowi do rozmowy.
          </p>
        </div>

        <div class="space-y-10">
          <div>
            <h3 class="text-[10px] font-bold text-muted uppercase tracking-[0.2em] mb-2">Dla Promotorów i Klubów</h3>
            <a href="mailto:partners@raveomat.pl" class="text-xl md:text-2xl font-display font-bold text-foreground hover:text-primary transition-colors">partners@raveomat.pl</a>
          </div>
          
          <div>
            <h3 class="text-[10px] font-bold text-muted uppercase tracking-[0.2em] mb-2">Support i Bilety</h3>
            <a href="mailto:support@raveomat.pl" class="text-xl md:text-2xl font-display font-bold text-foreground hover:text-primary transition-colors">support@raveomat.pl</a>
          </div>

          <div>
            <h3 class="text-[10px] font-bold text-muted uppercase tracking-[0.2em] mb-2">Siedziba Główna</h3>
            <p class="text-lg text-foreground font-medium">Bydgoszcz, Polska</p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <ContactForm client:load />
      </div>
    </div>
  </div>
</section>
