---
import NewsletterForm from "./NewsletterForm.svelte";
---

<section class="py-32 px-6 lg:px-8 bg-dark relative border-y border-white/5 overflow-hidden">
  <div class="absolute inset-0 z-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(circle at center, white 1.5px, transparent 1.5px); background-size: 32px 32px;"></div>
  
  <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-3xl h-32 bg-primary/10 blur-[100px] rounded-full z-0 pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-20">

    <div class="flex-1 text-center lg:text-left">
      <div class="inline-flex items-center justify-center lg:justify-start gap-3 mb-6 w-full">
        <span class="w-8 h-0.5 bg-primary"></span>
        <span class="text-xs font-bold uppercase tracking-[0.3em] text-primary">
          Ticket Alerts
        </span>
      </div>

      <h2 class="text-4xl sm:text-5xl md:text-6xl font-display font-extrabold tracking-tighter text-foreground uppercase mb-6 leading-[0.9]">
        Nie przegap dropu
      </h2>

      <p class="text-lg text-muted font-light max-w-xl mx-auto lg:mx-0 leading-relaxed">
        Pule Early Bird na najlepsze imprezy znikają w minuty. Zapisz się, aby otrzymywać powiadomienia o line-upach i startach sprzedaży w Twojej okolicy. Zero spamu.
      </p>
    </div>

    <NewsletterForm client:visible />

  </div>
</section>
