---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Strona nie znaleziona | Raveomat">
  <main class="min-h-screen bg-dark flex items-center justify-center pt-20">
    <div class="text-center px-6">
      <div class="mb-8">
        <span class="font-display text-[clamp(6rem,20vw,14rem)] font-extrabold tracking-tighter text-primary uppercase leading-none select-none">
          404
        </span>
      </div>
      <h1 class="text-2xl md:text-3xl font-display font-extrabold tracking-tighter text-foreground uppercase mb-4">
        Strona nie znaleziona
      </h1>
      <p class="text-muted text-lg max-w-md mx-auto mb-12 font-light">
        Wydarzenie, którego szukasz, prawdopodobnie zostało przeniesione lub nie istnieje.
      </p>
      <a
        href="/"
        class="inline-flex px-8 py-4 bg-primary text-dark font-bold text-xs uppercase tracking-widest hover:bg-white transition-colors duration-300"
      >
        Wróć na stronę główną
      </a>
    </div>
  </main>
</Layout>
