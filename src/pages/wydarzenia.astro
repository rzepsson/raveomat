---
import Layout from "../layouts/Layout.astro";
import TicketGrid from "../components/TicketGrid.svelte";
import { createSupabaseServerClient } from "../lib/supabase.server";
import type { EventGenre, EventType, EventStatus } from "../lib/types";

const supabase = createSupabaseServerClient(Astro.cookies);

interface EventRow {
  id: string;
  title: string;
  date: string;
  venue: string;
  price: number;
  status?: EventStatus;
  genre?: EventGenre;
  type?: EventType;
  image_url?: string;
}

let initialEvents: { id: string; title: string; date: string; venue: string; price: number; status: EventStatus; genre: EventGenre; type: EventType; imageUrl?: string }[] = [];

try {
  const { data, error } = await supabase
    .from("events")
    .select("*")
    .gte("date", new Date().toISOString())
    .order("date", { ascending: true });

  if (error) {
    console.error("Failed to fetch events:", error.message);
  } else {
    initialEvents = ((data || []) as EventRow[]).map((event) => ({
      id: event.id,
      title: event.title,
      date: event.date,
      venue: event.venue,
      price: event.price,
      status: event.status || ("available" as EventStatus),
      genre: event.genre || ("techno" as EventGenre),
      type: event.type || ("club" as EventType),
      imageUrl: event.image_url,
    }));
  }
} catch (err) {
  console.error("Supabase connection error:", err);
}
---

<Layout
  title="Wydarzenia | Raveomat"
  description="Przeglądaj wszystkie imprezy techno, house, drum & bass i trance w Europie. Kup bilety online bezpiecznie i szybko."
  canonical="/wydarzenia"
  ogType="website"
  ogImage="/content/rave_poster.jpg"
>
  <main class="pt-20">
    <TicketGrid initialEvents={initialEvents} client:load />
  </main>
</Layout>
