---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import FeaturedEvents from "../components/FeaturedEvents.svelte";
import Collectives from "../components/Collectives.astro";
import Newsletter from "../components/Newsletter.astro";
import Contact from "../components/Contact.astro";
import { fetchPartnersServer } from "../lib/partners";
import type { ProEvent, EventRow } from "../lib/types";

const SITE_URL = "https://raveomat.pl";
const supabase = Astro.locals.supabase;

let proEventsData: ProEvent[] = [];
let allEventsData: EventRow[] = [];
let partnersData: import("../lib/partners").Partner[] = [];

try {
  const proResult = await supabase
    .from("events")
    .select("id, title, subtitle, date, venue, price, image_url")
    .eq("promo_tier", "pro")
    .order("date", { ascending: true })
    .limit(10);

  if (proResult.error) {
    console.error("Failed to fetch pro events:", proResult.error.message);
  } else {
    proEventsData = proResult.data || [];
  }

  const allResult = await supabase
    .from("events")
    .select("id, title, date, venue, price, status, promo_tier, genre, type, image_url")
    .gte("date", new Date().toISOString())
    .order("date", { ascending: true })
    .limit(30);

  if (allResult.error) {
    console.error("Failed to fetch all events:", allResult.error.message);
  } else {
    allEventsData = allResult.data || [];
  }
  const partnersResult = await fetchPartnersServer(supabase);
  partnersData = partnersResult;
} catch (err) {
  console.error("Supabase connection error:", err);
}

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Raveomat",
    url: SITE_URL,
    inLanguage: "pl-PL",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Raveomat",
    url: SITE_URL,
    logo: `${SITE_URL}/favicon.svg`,
  },
];
---

<Layout
  title="Raveomat - Bilety na najlepsze imprezy Techno i Rave"
  description="Raveomat - Twój biletomautomat na najlepsze imprezy Techno i Rave w Europie. Kup bilety online bezpiecznie i szybko."
  canonical="/"
  ogImage="/content/rave_poster.jpg"
  ogType="website"
  jsonLd={jsonLd}
>
  <main>
    <Hero initialProEvents={proEventsData} />
    <FeaturedEvents initialEvents={allEventsData} client:visible />
    <Collectives partners={partnersData} />
    <Newsletter />
    <Contact />
  </main>
</Layout>
