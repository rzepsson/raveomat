---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import DashboardLayout from '../../components/dashboard/DashboardLayout.svelte';
import TabPromoter from '../../components/dashboard/TabPromoter.svelte';

const initialUser = Astro.locals.user
  ? { id: Astro.locals.user.id, email: Astro.locals.user.email ?? "" }
  : null;
---
<Layout title="Raveomat | Tryb Promotora">
  <DashboardLayout activePath="/panel/promotor" initialUser={initialUser} client:load>
    <TabPromoter client:only="svelte" />
  </DashboardLayout>
</Layout>
