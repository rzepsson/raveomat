---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import DashboardLayout from '../../components/dashboard/DashboardLayout.svelte';
import TabTickets from '../../components/dashboard/TabTickets.svelte';

const initialUser = Astro.locals.user
  ? { id: Astro.locals.user.id, email: Astro.locals.user.email ?? "" }
  : null;
---
<Layout title="Raveomat | Moje Bilety">
  <DashboardLayout activePath="/panel/bilety" initialUser={initialUser} client:load>
    <TabTickets client:only="svelte" />
  </DashboardLayout>
</Layout>
