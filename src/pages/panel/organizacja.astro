---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import DashboardLayout from '../../components/dashboard/DashboardLayout.svelte';
import TabOrganization from '../../components/dashboard/TabOrganization.svelte';

const initialUser = Astro.locals.user
  ? { id: Astro.locals.user.id, email: Astro.locals.user.email ?? "" }
  : null;
---
<Layout title="Raveomat | Twoja Organizacja">
  <DashboardLayout activePath="/panel/organizacja" initialUser={initialUser} client:load>
    <TabOrganization client:only="svelte" />
  </DashboardLayout>
</Layout>
