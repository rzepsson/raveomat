---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import DashboardLayout from '../../components/dashboard/DashboardLayout.svelte';
import TabSettings from '../../components/dashboard/TabSettings.svelte';

const initialUser = Astro.locals.user
  ? { id: Astro.locals.user.id, email: Astro.locals.user.email ?? "" }
  : null;
---
<Layout title="Raveomat | Ustawienia Konta">
  <DashboardLayout activePath="/panel/ustawienia" initialUser={initialUser} client:load>
    <TabSettings client:only="svelte" />
  </DashboardLayout>
</Layout>
