---
import Layout from "../layouts/Layout.astro";
import { createSupabaseServerClient } from "../lib/supabase.server";
import { fetchPartnersServer } from "../lib/partners";

const supabase = createSupabaseServerClient(Astro.cookies);

let partners = await fetchPartnersServer(supabase);
---

<Layout
  title="Partnerzy | Raveomat"
  description="Najlepsze polskie kolektywy i promotorzy. Wspólnie tworzymy nową jakość na scenie."
  canonical="/partnerzy"
  ogType="website"
  ogImage="/content/rave_poster.jpg"
>
  <main class="pt-20 min-h-screen bg-dark">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-32">
      <header class="mb-16">
        <span class="text-primary font-bold tracking-[0.2em] uppercase text-xs mb-4 block">
          Zaufali naszej technologii
        </span>
        <h1 class="text-5xl md:text-7xl font-display font-extrabold tracking-tighter uppercase text-foreground leading-none mb-6">
          Partnerzy
        </h1>
        <p class="text-xl text-muted font-light max-w-2xl">
          Najlepsze polskie kolektywy i promotorzy. Wspólnie tworzymy nową jakość na scenie.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {partners.map((p, index) => (
          <a
            href={`/partner/${p.slug}`}
            class="group relative p-8 rounded-none border border-white/10 bg-white/5 hover:bg-white/10 transition-all duration-300 flex flex-col justify-between min-h-72 backdrop-blur-sm"
            style={`animation-delay: ${index * 50}ms`}
          >
            <div class="absolute top-0 left-0 w-full h-1 bg-primary scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>

            <div class="flex justify-between items-start mb-8">
              <div class="w-20 h-20 bg-dark border border-white/10 flex items-center justify-center text-foreground group-hover:text-dark group-hover:bg-primary transition-colors duration-300 font-display text-3xl font-bold uppercase">
                {p.name.substring(0, 2)}
              </div>
              <span class="px-3 py-1 text-xs font-bold tracking-widest uppercase border border-white/10 text-muted rounded-full group-hover:border-primary/50 group-hover:text-primary transition-colors duration-300">
                {p.type}
              </span>
            </div>

            <div>
              <h3 class="text-3xl font-display font-bold mb-2 group-hover:text-white transition-colors">{p.name}</h3>
              <p class="text-muted text-sm mb-4">{p.description || ""}</p>

              <div class="flex items-center gap-3 text-muted text-xs font-bold uppercase tracking-widest mb-6">
                {p.city && <span>{p.city}</span>}
                {p.city && <span class="w-1 h-1 rounded-full bg-white/20"></span>}
                <span>{p.eventCount} Wydarzeń</span>
              </div>

              <div class="flex items-center gap-2 text-sm font-bold text-muted group-hover:text-primary transition-colors duration-300">
                ZOBACZ PROFIL
                <svg
                  class="w-5 h-5 transform group-hover:translate-x-2 transition-transform duration-300"
                  fill="none" stroke="currentColor" viewBox="0 0 24 24"
                >
                  <path d="M17 8l4 4m0 0l-4 4m4-4H3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
