# Supabase, required. Project Settings > API in the Supabase dashboard.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Rate limiting, optional. Defaults to an in-memory fixed window,
# which is per-process and resets on restart. Set to "redis" to use
# Upstash instead (needed if you run more than one instance).
# RATE_LIMIT_DRIVER=redis
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
